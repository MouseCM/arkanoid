<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1080" prefHeight="720"
            style="-fx-background-color: linear-gradient(to bottom, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">

    <!-- Glow Effect -->
    <effect>
        <DropShadow color="#4ecca3" radius="30" spread="0.3"/>
    </effect>

    <!-- Victory Title -->
    <VBox alignment="CENTER" layoutX="340" layoutY="120" spacing="10">
        <Label text="VICTORY!" style="-fx-text-fill: #4ecca3; -fx-font-size: 72px; -fx-font-weight: bold; -fx-font-family: 'Arial Black', sans-serif;">
            <effect>
                <DropShadow color="#4ecca3" radius="20" spread="0.5"/>
            </effect>
        </Label>
        
        <Label text="All Blocks Destroyed!" style="-fx-text-fill: #eeeeee; -fx-font-size: 24px; -fx-font-weight: normal;"/>
    </VBox>

    <!-- Score Display -->
    <HBox alignment="CENTER" layoutX="390" layoutY="320" spacing="15">
        <Label text="FINAL SCORE:" style="-fx-text-fill: #93b5c6; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Label fx:id="scoreLabel" text="0" style="-fx-text-fill: #f0a500; -fx-font-size: 28px; -fx-font-weight: bold;">
            <effect>
                <Glow level="0.8"/>
            </effect>
        </Label>
    </HBox>

    <!-- Buttons -->
    <HBox alignment="CENTER" layoutX="340" layoutY="520" spacing="30">
        <Button fx:id="playAgainButton" text="PLAY AGAIN" 
                style="-fx-background-color: #4ecca3; -fx-text-fill: #1a1a2e; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 12 30 12 30; -fx-background-radius: 5; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#4ecca3" radius="10" spread="0.3"/>
            </effect>
        </Button>
        
        <Button fx:id="mainMenuButton" text="MAIN MENU" 
                style="-fx-background-color: #93b5c6; -fx-text-fill: #1a1a2e; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 12 30 12 30; -fx-background-radius: 5; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#93b5c6" radius="10" spread="0.3"/>
            </effect>
        </Button>
        
        <Button fx:id="exitButton" text="EXIT" 
                style="-fx-background-color: #e94560; -fx-text-fill: #ffffff; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 12 30 12 30; -fx-background-radius: 5; -fx-cursor: hand;">
            <effect>
                <DropShadow color="#e94560" radius="10" spread="0.3"/>
            </effect>
        </Button>
    </HBox>

    <!-- Decorative Stars -->
    <Label text="★" layoutX="220" layoutY="140" style="-fx-text-fill: #f0a500; -fx-font-size: 36px;"/>
    <Label text="★" layoutX="820" layoutY="140" style="-fx-text-fill: #f0a500; -fx-font-size: 36px;"/>
    <Label text="★" layoutX="270" layoutY="200" style="-fx-text-fill: #4ecca3; -fx-font-size: 24px;"/>
    <Label text="★" layoutX="780" layoutY="200" style="-fx-text-fill: #4ecca3; -fx-font-size: 24px;"/>
    <Label text="★" layoutX="150" layoutY="350" style="-fx-text-fill: #93b5c6; -fx-font-size: 28px;"/>
    <Label text="★" layoutX="890" layoutY="350" style="-fx-text-fill: #93b5c6; -fx-font-size: 28px;"/>
    <Label text="★" layoutX="200" layoutY="500" style="-fx-text-fill: #f0a500; -fx-font-size: 20px;"/>
    <Label text="★" layoutX="860" layoutY="500" style="-fx-text-fill: #f0a500; -fx-font-size: 20px;"/>
    
</AnchorPane>