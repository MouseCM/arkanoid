<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           prefWidth="1080" prefHeight="720"
           style="-fx-background-color: linear-gradient(to bottom, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">

    <!-- Background stars effect -->
    <VBox alignment="CENTER" spacing="0">
        <Label text="★" textFill="#FFD700" opacity="0.3" style="-fx-font-size: 24px;" 
               translateX="-400" translateY="-250"/>
        <Label text="★" textFill="#FFD700" opacity="0.4" style="-fx-font-size: 18px;" 
               translateX="350" translateY="-200"/>
        <Label text="★" textFill="#FFD700" opacity="0.3" style="-fx-font-size: 20px;" 
               translateX="-300" translateY="150"/>
        <Label text="★" textFill="#FFD700" opacity="0.5" style="-fx-font-size: 22px;" 
               translateX="400" translateY="200"/>
    </VBox>

    <!-- Main content -->
    <VBox alignment="CENTER" spacing="30">
        
        <!-- Victory Banner -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="🎉" style="-fx-font-size: 80px;"/>
            
            <Label text="VICTORY!" textFill="#FFD700" style="-fx-font-size: 72px; -fx-font-weight: bold; -fx-font-family: 'Arial Black', sans-serif;">
                <effect>
                    <DropShadow color="#FF6B35" radius="20" spread="0.5"/>
                </effect>
            </Label>
            
            <Label text="ALL BLOCKS DESTROYED!" textFill="#00D9FF" 
                   style="-fx-font-size: 28px; -fx-font-weight: bold;">
                <effect>
                    <DropShadow color="#0077B6" radius="10" spread="0.3"/>
                </effect>
            </Label>
        </VBox>

        <!-- Score section -->
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 15px; -fx-padding: 30px;">
            <HBox alignment="CENTER" spacing="15">
                <Label text="FINAL SCORE:" textFill="#FFFFFF" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="scoreLabel" text="12,500" textFill="#FFD700" 
                       style="-fx-font-size: 32px; -fx-font-weight: bold;">
                    <effect>
                        <Glow level="0.8"/>
                    </effect>
                </Label>
            </HBox>
            
            <HBox alignment="CENTER" spacing="50">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="⏱️" style="-fx-font-size: 28px;"/>
                    <Label text="TIME" textFill="#CCCCCC" style="-fx-font-size: 16px;"/>
                    <Label fx:id="timeLabel" text="2:34" textFill="#FFFFFF" 
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
                
                <VBox alignment="CENTER" spacing="5">
                    <Label text="💎" style="-fx-font-size: 28px;"/>
                    <Label text="ACCURACY" textFill="#CCCCCC" style="-fx-font-size: 16px;"/>
                    <Label fx:id="accuracyLabel" text="87%" textFill="#FFFFFF" 
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
                
                <VBox alignment="CENTER" spacing="5">
                    <Label text="🏆" style="-fx-font-size: 28px;"/>
                    <Label text="RANK" textFill="#CCCCCC" style="-fx-font-size: 16px;"/>
                    <Label fx:id="rankLabel" text="S" textFill="#FFD700" 
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="nextLevelButton" text="NEXT LEVEL" 
                    style="-fx-background-color: #00D9FF; -fx-text-fill: #0F3460; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15 40; -fx-background-radius: 10px; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#00D9FF" radius="15" spread="0.4"/>
                </effect>
            </Button>
            
            <Button fx:id="replayButton" text="REPLAY" 
                    style="-fx-background-color: #FFD700; -fx-text-fill: #0F3460; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15 40; -fx-background-radius: 10px; -fx-cursor: hand;">
                <effect>
                    <DropShadow color="#FFD700" radius="15" spread="0.4"/>
                </effect>
            </Button>
            
            <Button fx:id="mainMenuButton" text="MAIN MENU" 
                    style="-fx-background-color: rgba(255, 255, 255, 0.2); -fx-text-fill: #FFFFFF; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15 40; -fx-background-radius: 10px; -fx-cursor: hand; -fx-border-color: #FFFFFF; -fx-border-width: 2px; -fx-border-radius: 10px;">
            </Button>
        </HBox>

        <!-- Footer message -->
        <Label text="Press any button to continue..." textFill="#AAAAAA" 
               style="-fx-font-size: 16px; -fx-font-style: italic;">
            <VBox.margin>
                <Insets top="20"/>
            </VBox.margin>
        </Label>
        
    </VBox>
    
</StackPane>