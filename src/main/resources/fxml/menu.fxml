<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17" 
           xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.controller.MenuController"
           prefWidth="1080" 
           prefHeight="720"
           style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e);">
    
    <VBox alignment="CENTER" spacing="30">
        <padding>
            <Insets top="50" bottom="50" left="50" right="50"/>
        </padding>
        
        <!-- Title -->
        <Text text="ARKANOID" 
              fill="white" 
              style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 5);">
            <VBox.margin>
                <Insets bottom="50"/>
            </VBox.margin>
        </Text>
        
        <!-- Start Button -->
        <Button fx:id="startButton" 
                text="START GAME" 
                prefWidth="300" 
                prefHeight="60"
                style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10; -fx-cursor: hand;"
                onMouseEntered="#onStartHover"
                onMouseExited="#onStartExit"
                onAction="#onStartClicked"/>
        
        <!-- Settings Button -->
        <Button fx:id="settingsButton" 
                text="SETTINGS" 
                prefWidth="300" 
                prefHeight="60"
                style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10; -fx-cursor: hand;"
                onMouseEntered="#onSettingsHover"
                onMouseExited="#onSettingsExit"
                onAction="#onSettingsClicked"/>
        
        <!-- About Button -->
        <Button fx:id="aboutButton" 
                text="ABOUT" 
                prefWidth="300" 
                prefHeight="60"
                style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10; -fx-cursor: hand;"
                onMouseEntered="#onAboutHover"
                onMouseExited="#onAboutExit"
                onAction="#onAboutClicked"/>
        
    </VBox>
</StackPane>